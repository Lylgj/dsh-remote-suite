{
  "name": "@lylgj/dsh-remote-suite",
  "version": "0.1.0",
  "description": "WSL, SSH, Docker and remote-daemon workspaces in one DeepSeek Harness plugin: one Backend seam, one sidebar entry, one `remote` tool.",
  "type": "module",
  "main": "index.js",
  "author": "Lylgj",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Lylgj/dsh-remote-suite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lylgj/dsh-remote-suite.git"
  },
  "bugs": {
    "url": "https://github.com/Lylgj/dsh-remote-suite/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "THIRD-PARTY-NOTICES.md",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wsl",
    "ssh",
    "docker",
    "remote-workspace"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/api-smoke.mjs && node test/client-smoke.mjs && node test/pty-smoke.mjs && node test/docker-smoke.mjs && node test/secrets-smoke.mjs && node test/mirror-smoke.mjs && node test/errors-smoke.mjs",
    "test:ssh": "node test/ssh-smoke.mjs",
    "test:jump": "node test/ssh-jump-smoke.mjs",
    "test:daemon": "node test/daemon-smoke.mjs",
    "test:tunnel": "node test/tunnel-smoke.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
